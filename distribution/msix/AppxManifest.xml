<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX マニフェストテンプレ (Wave 4A)

  生成:
    src-tauri/build-helpers/gen_msix_manifest.ps1 で
    ${VERSION} / ${ARCH} を置換し、x64 / arm64 2 ファイル生成。
    Publisher は manifest 既定 (CN=EasyCursorSwap, ...) を使用し、
    MSIX_PUBLISHER env があるときだけ上書きする。

  設計根拠:
   - runFullTrust: Tauri Win32 ホスト (CryptProtectData / HKCU 直書込み) に必要
   - rescap:unvirtualizedResources + desktop6:RegistryWriteVirtualization=disabled
       を両方宣言して host HKCU に実書込み可能とする
       (Microsoft Learn "Flexible virtualization" 2026-01-28 更新版に準拠)
   - desktop:StartupTask は MSIX の自動起動宣言。autostart::set_enabled は
     MSIX 環境では no-op となり、OS のスタートアップ設定で操作する。
   - .cursorpack file association は NSIS/MSI の
     src-tauri/tauri.conf.json:42-49 と並列に宣言する。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap uap5 rescap desktop desktop6">

  <Identity
    Name="dev.easycursorswap.app"
    Publisher="${PUBLISHER}"
    Version="${VERSION}"
    ProcessorArchitecture="${ARCH}" />

  <Properties>
    <DisplayName>EasyCursorSwap</DisplayName>
    <PublisherDisplayName>EasyCursorSwap</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!--
      flexible-virtualization: host HKCU への実書込みを有効化。
      ${ARCH} 等の置換対象は <Properties> の外で残す。
    -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="easy-cursor-swap.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="EasyCursorSwap"
        Description="Win11 cursor manager"
        BackgroundColor="#0a0b0f"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="EasyCursorSwap"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          サイレント自動起動。HKCU\Software\Microsoft\Windows\CurrentVersion\Run の
          MSIX 版代替。OS 設定 → スタートアップ アプリで操作。
        -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask
            TaskId="EasyCursorSwapStartup"
            Enabled="false"
            DisplayName="EasyCursorSwap" />
        </desktop:Extension>

        <!--
          .cursorpack ファイル関連付け (NSIS/MSI の tauri.conf.json:42-49 と並列)
        -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="cursorpack">
            <uap:SupportedFileTypes>
              <uap:FileType>.cursorpack</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      runFullTrust + unvirtualizedResources を両方宣言。
      単体指定では host HKCU まで到達せず仮想化される (2026-06-09 スパイクで再現確認)。
    -->
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
